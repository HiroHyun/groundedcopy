---
import openai from '../assets/logos/OAI_OpenAI-Blossom_Black.svg?url';
const { t } = Astro.props;
const w = t.where;
const fragments = [
  { kind: 'term', lines: [['$', 'claude plugin marketplace add HiroHyun/grounded-copy'], ['$', 'claude plugin install grounded-copy@hirohyun-plugins -s user'], ['$', 'claude'], ['', 'Loading grounded prose rules...']] },
  { kind: 'term', lines: [['$', 'codex plugin marketplace add HiroHyun/grounded-copy'], ['$', 'codex plugin add grounded-copy@hirohyun-plugins'], ['$', 'codex'], ['›', '$grounded-profile status']] },
  { kind: 'term', lines: [['$', 'npx skills add HiroHyun/grounded-copy --skill grounded-copy --yes'], ['', ''], ['›', w.ask]] },
  { kind: 'box', lines: [['', '## The one banned move'], ['', 'A denial followed by a claim tells the reader that someone raised the denied thing. When nobody did, the denial is a foil that makes the claim sound sharper. Delete it and keep the fact.']] },
];
// Codex shows OpenAI's logo as OpenAI provides it (openai.com/brand). The other rows use Lucide
// icons (ISC licence, src/assets/icons/LICENSE-lucide.txt): a terminal, a puzzle piece, a message.
const icons: (string[] | null)[] = [
  ['m7 11 2-2-2-2', 'M11 13h4', 'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z'],
  null,
  ['M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z'],
  ['M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z', 'M13 8H7', 'M17 12H7'],
];
---
<section class="where section" data-field="sand" aria-labelledby="where-title">
  <div class="wrap">
    <h2 id="where-title" data-rise>{w.heading}</h2>
    <ul>
      {w.rows.map((row: any, i: number) => (
        <li class="row grid" data-tilt>
          <div class="about">
            <span class="icon" data-ui aria-hidden="true">{icons[i] ? <svg viewBox="0 0 24 24" focusable="false">{icons[i]!.map((d) => <path d={d} />)}</svg> : <img src={openai} alt="" width="51" height="51" />}</span>
            <div class="words">
              <div class="title"><h3>{row.name}</h3><p class="kind">{row.kind}</p></div>
              <p>{row.text}</p>
            </div>
          </div>
          <div class:list={['shot', 'window', fragments[i].kind]} data-ui data-lean tabindex="0" role="group" aria-label={row.name}>
            <p class="bar"><span class="lights" aria-hidden="true"><span></span><span></span><span></span></span><span>{fragments[i].kind === 'box' ? w.instructions : w.terminal}</span><span class="chevron" aria-hidden="true"></span></p>
            <pre><code>{fragments[i].lines.map(([prompt, text], n) => <>{n > 0 && '\n'}{prompt && <span class="prompt">{prompt}</span>}{text}</>)}{fragments[i].kind === 'term' && <span class="caret" aria-hidden="true"></span>}</code></pre>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  h2 { font-size: var(--step-head); }
  ul { display: grid; gap: clamp(1.5rem, 1rem + 1.5vw, 2.75rem); margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 3rem); }
  .row { align-items: center; row-gap: 1rem; }
  .about { grid-column: 1 / span 5; grid-row: 1; position: relative; z-index: 1; display: flex; gap: 1.25rem; align-items: flex-start; }
  .words { display: grid; gap: 0.6rem; min-width: 0; }
  .title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.9rem; }
  h3 { font-size: var(--step-lead); line-height: 1.15; }
  .kind { color: var(--muted); }
  .words > p { max-width: 38ch; }

  /* A white tile, lit from above, with a thickness along its lower edge, lifted off the page. */
  .icon {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.95rem;
    background: #fff;
    color: var(--night);
    box-shadow: inset 0 -0.2rem 0 rgb(8 20 17 / 0.1), 0 0.3rem 0 -0.05rem rgb(8 20 17 / 0.1), 0 0.75rem 1.4rem -0.35rem rgb(8 20 17 / 0.3); /* taste-skill-ignore: layered windows, asked for in review */
    transition: transform var(--t-spring) var(--spring);
  }
  .icon svg { width: 1.55rem; height: 1.55rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  /* OpenAI's file keeps a margin around its mark; at this size the mark matches the other icons. */
  .icon img { width: 3.2rem; height: 3.2rem; }

  .shot { grid-column: 6 / -1; grid-row: 1; min-width: 0; background: var(--night-paper); color: var(--bone); overflow-wrap: anywhere; }
  .bar { display: flex; align-items: center; gap: 0.75rem; padding: 0.65rem 1.25rem; background: rgb(255 255 255 / 0.06); border-radius: 0.875rem 0.875rem 0 0; color: var(--sage); }
  .chevron { display: none; }
  .shot pre { padding: 1rem 1.5rem 1.25rem; }
  .shot pre, .shot code { line-height: 1.65; }
  .shot .prompt { color: var(--amber); margin-right: 0.6em; }
  .shot.box { background: var(--paper); color: var(--forest); }
  .shot.box .bar { background: rgb(19 51 43 / 0.06); color: var(--clay); }
  .shot.box pre, .shot.box code { font-family: var(--text); font-size: var(--step-body); }
  .shot:focus-visible { outline-offset: 6px; }

  @media (prefers-reduced-motion: no-preference) {
    /* Wide screens: each row starts with its words centred over a veiled window. Under the pointer,
       on a tap or on keyboard focus the words move to their column and the window comes clear. */
    @media (min-width: 901px) {
      :global(.js) .about { transform: translateX(70%); transition: transform 720ms var(--spring); }
      :global(.js) .shot { filter: blur(14px); opacity: 0.14; --x: -24%; --grow: 0.9; transition: filter 420ms var(--ease-out), opacity 420ms var(--ease-out), transform 720ms var(--spring); }
      :global(.js) .row.is-open .about, :global(.js) .row:has(:focus-visible) .about { transform: none; }
      :global(.js) .row.is-open .shot, :global(.js) .row:has(:focus-visible) .shot { filter: none; opacity: 1; --x: 0%; --grow: 1; }
      .row.is-open .icon, .row:has(:focus-visible) .icon { transform: translateY(-0.2rem) scale(1.06); }
    }
    @media (min-width: 901px) and (hover: hover) and (pointer: fine) {
      :global(.js) .row:hover .about { transform: none; }
      :global(.js) .row:hover .shot { filter: none; opacity: 1; --x: 0%; --grow: 1; }
      .row:hover .icon { transform: translateY(-0.2rem) scale(1.06); }
    }
    /* Narrow screens: the window shows its bar and a veiled first line. A tap presses it in, then it
       springs open downward and comes clear. */
    @media (max-width: 900px) {
      :global(.js) .shot { height: 6.25rem; overflow: clip; cursor: pointer; transition: transform var(--t-spring) var(--spring); }
      :global(.js) .shot pre { filter: blur(5px); opacity: 0.45; transition: filter 420ms var(--ease-out), opacity 420ms var(--ease-out); }
      :global(.js) .row.is-open .shot { height: auto; }
      :global(.js) .row.is-open .shot pre { filter: none; opacity: 1; }
      :global(.js) .row.is-pressed .shot { --grow: 0.96; transition-duration: 120ms; }
      :global(.js) .chevron { display: block; margin-left: auto; width: 0.55rem; height: 0.55rem; border: solid currentColor; border-width: 0 2px 2px 0; transform: translateY(-0.15rem) rotate(45deg); transition: transform var(--t-spring) var(--spring); }
      :global(.js) .row.is-open .chevron { transform: translateY(0.1rem) rotate(225deg); }
      .row.is-open .icon { transform: translateY(-0.2rem) scale(1.06); }
    }
  }

  @media (max-width: 900px) {
    .about, .shot { grid-column: 1 / -1; }
    .shot { grid-row: 2; }
  }
</style>

<script>
  import { morph, reduce } from '../scripts/motion';

  // A tap opens a row: on a narrow screen its window grows downward to full height; on a wide
  // touch screen the row does what a pointer does on hover. A mouse on a wide screen uses hover.
  const narrow = matchMedia('(max-width: 900px)');
  document.querySelectorAll<HTMLElement>('.where .row').forEach((row) => {
    const shot = row.querySelector<HTMLElement>('.shot')!;
    let touch = false;
    const toggle = () => {
      if (narrow.matches) morph(shot, () => row.classList.toggle('is-open'), null);
      else row.classList.toggle('is-open');
    };
    row.addEventListener('pointerdown', (e) => {
      touch = e.pointerType !== 'mouse';
      if (narrow.matches && !reduce.matches) row.classList.add('is-pressed');
    });
    for (const type of ['pointerup', 'pointercancel', 'pointerleave']) row.addEventListener(type, () => row.classList.remove('is-pressed'));
    row.addEventListener('click', () => {
      if (reduce.matches || (!narrow.matches && !touch)) return;
      toggle();
    });
    shot.addEventListener('keydown', (e) => {
      if (!narrow.matches || (e.key !== 'Enter' && e.key !== ' ')) return;
      e.preventDefault();
      toggle();
    });
  });
</script>
