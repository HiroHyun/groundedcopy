---
import { Image } from 'astro:assets';
import { pictures } from '../data/pictures';
const { t } = Astro.props;
const fills = ['var(--amber)', 'var(--sage)', 'var(--stone)', 'var(--mint)'];
const lang = t.lang as 'en' | 'zh';
---
<section class="switches section" data-field="sand" aria-labelledby="switches-title">
  <div class="wrap">
    <h2 id="switches-title" data-rise>{t.switches.heading}</h2>
    <ul>
      {t.switches.bands.map((band: any, i: number) => (
        <li class="band" data-on="false" data-tilt style={`--fill:${fills[i % fills.length]}`}>
          <div class="text">
            <p class="sentence">
              {band.parts.map(([text, kind]: [string, string?]) =>
                kind
                  ? <span class={kind}>{text}</span>
                  : text.split(/(\s+)/).map((w) => (/^\s+$/.test(w) ? w : w && <span class="keep">{w}</span>)),
              )}
            </p>
            <div class="note"><div><p>{band.note}</p></div></div>
          </div>
          <figure class="pic">
            <Image src={pictures[i].src} alt={pictures[i].alt[lang]} widths={[480, 800, 1200]} sizes="(max-width: 1100px) 100vw, 22vw" style={`object-position:${pictures[i].position}`} />
          </figure>
          <button class="switch" type="button" role="switch" aria-checked="false" aria-label={t.switches.label} data-ui>
            <span class="track" aria-hidden="true"><span class="thumb" /></span>
            <span class="state" aria-hidden="true">{t.switches.off}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  h2 { font-size: var(--step-head); max-width: 18ch; }
  ul { display: grid; gap: clamp(0.75rem, 0.5rem + 0.6vw, 1.25rem); margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem); }

  /* Each sentence sits on a card with a lit top edge and a thicker, darker lower edge, its picture
     set into it. Switched on, the card takes its colour and its lower edge deepens. */
  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(11rem, 20vw, 22rem) auto;
    min-height: clamp(7.5rem, 5rem + 6vh, 10.5rem);
    border-radius: 1.25rem;
    background-color: var(--paper);
    overflow: clip;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.95), inset 0 -0.35rem 0 rgb(8 20 17 / 0.1), inset 0 0 0 1px rgb(8 20 17 / 0.06); /* taste-skill-ignore: raised cards, asked for in review */
    transition: background-color 280ms var(--ease-out), box-shadow var(--t-spring) var(--spring);
  }
  .band[data-on='true'] {
    background-color: var(--fill);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.55), inset 0 -0.45rem 0 rgb(8 20 17 / 0.18), inset 0 0 0 1px rgb(8 20 17 / 0.08); /* taste-skill-ignore: raised cards, asked for in review */
  }
  .text { align-self: center; padding: 1.25rem clamp(1.25rem, 0.75rem + 1.5vw, 2.25rem); }
  .pic { position: relative; margin: 0.5rem 0 0.85rem; border-radius: 0.875rem; overflow: hidden; }
  .pic img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
  }
  .switch { align-self: center; margin-inline: clamp(1rem, 0.5rem + 1vw, 1.75rem); }
  .sentence {
    font-family: var(--display);
    font-weight: 500;
    font-optical-sizing: auto;
    font-size: var(--step-quote);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--muted);
    transition: color 300ms ease;
    max-width: 36ch;
  }
  :lang(zh-Hans) .sentence { font-weight: 700; letter-spacing: 0; line-height: 1.3; max-width: 16em; }
  .band[data-on='true'] .sentence { color: var(--forest); }
  .cut {
    text-decoration-line: line-through;
    text-decoration-thickness: max(3px, 0.08em);
    text-decoration-color: transparent;
    transition: text-decoration-color 260ms ease;
  }
  .cut.is-struck { text-decoration-color: currentColor; }
  .add { display: none; }
  .band[data-on='true'] .cut { display: none; }
  .band[data-on='true'] .add { display: inline; }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.25rem;
    border: 0;
    background: none;
    color: var(--forest);
    font-size: var(--step-small);
    font-weight: 600;
  }
  /* The track is pressed into the card; the thumb stands on it. */
  .switch[data-ui] .track {
    position: relative;
    display: block;
    width: 4.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--stone);
    box-shadow: inset 0 2px 4px rgb(8 20 17 / 0.3), inset 0 0 0 1px rgb(8 20 17 / 0.06), 0 1px 0 rgb(255 255 255 / 0.75);
    transition: background-color 200ms ease;
  }
  .switch[data-ui][aria-checked='true'] .track { background: var(--forest); box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.45), 0 1px 0 rgb(255 255 255 / 0.35); }
  .switch[data-ui] .thumb {
    position: absolute;
    top: 0.25rem;
    left: 0.25rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), inset 0 -1.5px 0 rgb(8 20 17 / 0.14), 0 1px 2px rgb(8 20 17 / 0.3), 0 3px 8px -1px rgb(8 20 17 / 0.3);
    transition: transform var(--t-spring) var(--spring), background-color 200ms ease;
  }
  .switch[aria-checked='true'] .thumb { transform: translateX(2rem); background: var(--fill); }
  .state { min-width: 2ch; }
  .switch:active .thumb { transform: scale(0.94); }
  .switch[aria-checked='true']:active .thumb { transform: translateX(2rem) scale(0.94); }

  .note { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 280ms var(--ease-out); }
  .note > div { overflow: hidden; }
  .note p { padding-top: 0.6rem; color: var(--forest); font-size: var(--step-body); max-width: 46ch; }
  .band[data-on='true'] .note { grid-template-rows: 1fr; }

  @media (max-width: 1100px) {
    .band { grid-template-columns: minmax(0, 1fr) auto; }
    .pic { grid-column: 1 / -1; grid-row: 2; margin: 0 0.5rem 0.85rem; aspect-ratio: 21 / 6; }
  }
  @media (max-width: 760px) {
    .state { display: none; }
    .pic { aspect-ratio: 16 / 6; }
  }
  @media (prefers-reduced-motion: reduce) {
    .band, .note, .thumb, .sentence, .cut { transition: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  function wordRects(sentence: Element) {
    return [...sentence.querySelectorAll<HTMLElement>('.keep')].map((el) => el.getBoundingClientRect());
  }

  // FLIP: kept words glide from where they sat in the draft to where they sit now.
  function glide(sentence: Element, before: DOMRect[]) {
    const keeps = [...sentence.querySelectorAll<HTMLElement>('.keep')];
    keeps.forEach((el, i) => {
      const now = el.getBoundingClientRect();
      const dx = before[i].left - now.left;
      const dy = before[i].top - now.top;
      if (!dx && !dy) return;
      el.style.display = 'inline-block';
      el.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], {
        duration: 520,
        easing: 'cubic-bezier(0.77, 0, 0.175, 1)',
      }).finished.finally(() => (el.style.display = ''));
    });
  }

  async function setBand(band: HTMLElement, on: boolean, labels: { on: string; off: string }) {
    const sentence = band.querySelector('.sentence')!;
    const button = band.querySelector<HTMLButtonElement>('.switch')!;
    button.setAttribute('aria-checked', String(on));
    band.querySelector('.state')!.textContent = on ? labels.on : labels.off;
    if (reduce.matches) {
      band.dataset.on = String(on);
      return;
    }
    const cuts = sentence.querySelectorAll<HTMLElement>('.cut');
    if (on && cuts.length) {
      cuts.forEach((c) => c.classList.add('is-struck'));
      await new Promise((r) => setTimeout(r, 520));
    }
    const before = wordRects(sentence);
    band.dataset.on = String(on);
    glide(sentence, before);
    sentence.querySelectorAll<HTMLElement>(on ? '.add' : '.cut').forEach((el) =>
      el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 320, delay: on ? 260 : 120, easing: 'ease', fill: 'backwards' }),
    );
    if (!on) cuts.forEach((c) => c.classList.remove('is-struck'));
  }

  document.querySelectorAll<HTMLElement>('.switches').forEach((section) => {
    const lang = document.documentElement.lang;
    const labels = lang.startsWith('zh') ? { on: '开', off: '关' } : { on: 'On', off: 'Off' };
    const bands = [...section.querySelectorAll<HTMLElement>('.band')];
    bands.forEach((band) => {
      band.querySelector('.switch')!.addEventListener('click', () => {
        band.dataset.touched = 'true';
        setBand(band, band.dataset.on !== 'true', labels);
      });
    });
    if (reduce.matches) return;
    // All four start off. Each switches itself on once it is well in view, one at a time,
    // unless the reader has already used its switch.
    const inView = new Set<Element>();
    const queue: HTMLElement[] = [];
    let busy = false;
    const next = () => {
      const band = queue.shift();
      if (!band) return void (busy = false);
      if (band.dataset.touched || !inView.has(band)) return next();
      band.dataset.touched = 'auto';
      io.unobserve(band);
      setBand(band, true, labels);
      setTimeout(next, 1300);
    };
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const band = entry.target as HTMLElement;
        if (entry.intersectionRatio >= 0.75) {
          inView.add(band);
          if (!band.dataset.touched && !queue.includes(band)) queue.push(band);
        } else inView.delete(band);
      }
      if (!busy && queue.length) {
        busy = true;
        setTimeout(next, 500);
      }
    }, { threshold: [0, 0.75] });
    bands.forEach((band) => io.observe(band));
  });
</script>
