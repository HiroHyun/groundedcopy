---
import '../styles/global.css';
import { Font } from 'astro:assets';
import newsreader from '../assets/fonts/Newsreader-Variable.woff2?url';

interface Props { t: { lang: string; htmlLang: string; title: string; description: string; skip: string } }
const { t } = Astro.props;
const base = import.meta.env.BASE_URL;
const zh = t.lang === 'zh';
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(base, Astro.site);
const image = new URL(`${base}${zh ? 'og-zh.png' : 'og.png'}`, Astro.site);
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#0f2620" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={home} />
    <link rel="alternate" hreflang="zh-Hans" href={new URL('zh/', home)} />
    <link rel="alternate" hreflang="x-default" href={home} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={newsreader} as="font" type="font/woff2" crossorigin />
    <Font cssVariable="--font-text" preload />
    <Font cssVariable="--font-code" />
    {zh && <Font cssVariable="--font-display-zh" />}
    {zh && <Font cssVariable="--font-text-zh" />}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip plate" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>

<style>
  .skip { position: absolute; left: var(--margin); top: -4rem; z-index: 10; background: var(--amber); color: var(--night); }
  .skip:focus-visible { top: 1rem; }
</style>

<script>
  import '../scripts/reveal';
  import { lean } from '../scripts/motion';
  document.querySelectorAll<HTMLElement>('[data-lean], .plate').forEach((el) => lean(el, el.classList.contains('plate') ? 12 : 6));
</script>
